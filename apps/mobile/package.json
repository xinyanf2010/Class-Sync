{
  "name": "@classsync/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "EXPO_NO_DEPENDENCY_VALIDATION=1 EXPO_PUBLIC_SERVER_URL=\"http://${EXPO_HOST_IP:-$(ipconfig getifaddr en0 2>/dev/null || hostname -I | awk '{print $1}')}:4000\" expo start --host lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:dev:android": "eas build --profile development --platform android"
  },
  "dependencies": {
    "@classsync/common": "*",
    "expo": "^57.0.23",
    "expo-dev-client": "~57.0.19",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "^0.86.3",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.4",
    "eas-cli": "^24.12.1",
    "fsevents": "^2.3.3",
    "typescript": "~6.0.3"
  }
}
